#!/usr/bin/env python3
"""Янтарь: быстрое переключение Google-аккаунтов Antigravity.

Linux: GNOME Keyring через secret-tool (атрибуты service=gemini, username=antigravity).
Windows: Windows Credential Manager (target gemini:antigravity) через PowerShell P/Invoke.
Токены остаются локально; vault — приватные файлы 0600.
"""
import json
import os
import platform
import re
import subprocess
import sys
import tempfile
import time

WIN = platform.system() == "Windows"
VAULT = os.path.expanduser("~/.gemini/antigravity-accounts")
INDEX = os.path.join(VAULT, "index.json")
CURRENT = os.path.join(VAULT, "current")
LABEL = "Password for 'antigravity' on 'gemini'"
STORAGE = os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")),
                       "Antigravity", "app_storage.json")
CRED_TARGETS = ["gemini:antigravity", "LegacyGeneric:gemini:antigravity", "antigravity"]

PS_CRED = r'''
Add-Type @"
using System;
using System.Runtime.InteropServices;
public static class AmberCred {
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
  public struct CREDENTIAL {
    public uint Flags;
    public uint Type;
    public string TargetName;
    public string Comment;
    public System.Runtime.InteropServices.ComTypes.FILETIME LastWritten;
    public uint CredentialBlobSize;
    public IntPtr CredentialBlob;
    public uint Persist;
    public uint AttributeCount;
    public IntPtr Attributes;
    public string TargetAlias;
    public string UserName;
  }
  [DllImport("advapi32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
  public static extern bool CredRead(string target, uint type, uint flags, out IntPtr cred);
  [DllImport("advapi32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
  public static extern bool CredWrite(ref CREDENTIAL cred, uint flags);
  [DllImport("advapi32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
  public static extern bool CredDelete(string target, uint type, uint flags);
  [DllImport("advapi32.dll")]
  public static extern void CredFree(IntPtr cred);
}
"@
'''


def ps_run(script):
    with tempfile.NamedTemporaryFile("w", suffix=".ps1", delete=False, encoding="utf-8") as f:
        f.write(PS_CRED + script)
        path = f.name
    try:
        r = subprocess.run(["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass",
                            "-File", path], capture_output=True, text=True)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    finally:
        os.unlink(path)


def win_read():
    script = r'''
foreach ($t in @('gemini:antigravity','LegacyGeneric:gemini:antigravity','antigravity')) {
  $p = [IntPtr]::Zero
  if ([AmberCred]::CredRead($t, 1, 0, [ref]$p)) {
    $c = [Runtime.InteropServices.Marshal]::PtrToStructure($p, [type][AmberCred+CREDENTIAL])
    $b = New-Object byte[] $c.CredentialBlobSize
    [Runtime.InteropServices.Marshal]::Copy($c.CredentialBlob, $b, 0, $c.CredentialBlobSize)
    [AmberCred]::CredFree($p)
    $s = [Text.Encoding]::UTF8.GetString($b)
    if ($s -match 'id_token_email') { Write-Output $s; exit 0 }
    $s = [Text.Encoding]::Unicode.GetString($b)
    if ($s -match 'id_token_email') { Write-Output $s; exit 0 }
  }
}
exit 3
'''
    code, out, err = ps_run(script)
    if code != 0 or not out:
        return ""
    return out


def win_write(data):
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as f:
        f.write(data.strip())
        src = f.name
    script = r'''
$json = [IO.File]::ReadAllText(%s)
foreach ($t in @('gemini:antigravity','LegacyGeneric:gemini:antigravity','antigravity')) {
  [AmberCred]::CredDelete($t, 1, 0) | Out-Null
}
$b = [Text.Encoding]::UTF8.GetBytes($json)
$ptr = [Runtime.InteropServices.Marshal]::AllocHGlobal($b.Length)
[Runtime.InteropServices.Marshal]::Copy($b, 0, $ptr, $b.Length)
$c = New-Object AmberCred+CREDENTIAL
$c.Type = 1
$c.TargetName = 'gemini:antigravity'
$c.CredentialBlobSize = $b.Length
$c.CredentialBlob = $ptr
$c.Persist = 2
$c.UserName = 'antigravity'
if (-not [AmberCred]::CredWrite([ref]$c, 0)) { exit 4 }
[Runtime.InteropServices.Marshal]::FreeHGlobal($ptr)
Write-Output 'ok'
''' % json.dumps(src)
    try:
        code, out, err = ps_run(script)
        if code != 0:
            raise RuntimeError("CredWrite failed: " + err[:200])
    finally:
        os.unlink(src)


def run_keyring(args, input_data=None):
    return subprocess.run(["secret-tool"] + args, input=input_data,
                          capture_output=True, text=True, check=True).stdout


def read_keyring():
    if WIN:
        return win_read()
    return run_keyring(["lookup", "service", "gemini", "username", "antigravity"]).strip()


def write_keyring(data):
    if WIN:
        win_write(data)
        if not win_read():
            raise RuntimeError("ключ не найден после записи в Credential Manager")
        return
    # В GNOME Keyring могут быть несколько записей с service=gemini;
    # store создаёт новую, а lookup возвращает старую — поэтому сначала чистим.
    run_keyring(["clear", "service", "gemini"])
    run_keyring(["store", "--label", LABEL, "service", "gemini", "username", "antigravity"],
                data.strip() + "\n")
    if not run_keyring(["lookup", "service", "gemini", "username", "antigravity"]).strip():
        raise RuntimeError("ключ не найден после записи в GNOME Keyring")


def clear_keyring():
    if WIN:
        ps_run(r'''foreach ($t in @('gemini:antigravity','LegacyGeneric:gemini:antigravity','antigravity')) {
          [AmberCred]::CredDelete($t, 1, 0) | Out-Null
        }''')
    else:
        subprocess.run(["secret-tool", "clear", "service", "gemini"], check=False)


def email_of(raw):
    d = json.loads(raw)
    return d.get("id_token_email") or d.get("token", {}).get("email", "")


def load_index():
    if os.path.isfile(INDEX):
        try:
            return json.load(open(INDEX, encoding="utf-8"))
        except Exception:
            pass
    return {}


def save_index(idx):
    json.dump(idx, open(INDEX, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    os.chmod(INDEX, 0o600)


def slug(label):
    s = re.sub(r"[^a-zA-Z0-9_-]+", "-", label.lower()).strip("-")
    return s or "account"


def current_label():
    return open(CURRENT).read().strip() if os.path.isfile(CURRENT) else ""


def restart_app():
    if WIN:
        subprocess.run(["taskkill", "/F", "/IM", "Antigravity.exe"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(2)
        launcher = os.path.join(os.path.dirname(os.path.abspath(__file__)), "amber.py")
        flags = subprocess.CREATE_NO_WINDOW if hasattr(subprocess, "CREATE_NO_WINDOW") else 0
        subprocess.Popen([sys.executable, launcher], creationflags=flags,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    for p in subprocess.run(["pgrep", "-x", "antigravity"], capture_output=True, text=True).stdout.split():
        subprocess.run(["kill", p], check=False)
    time.sleep(2)
    env = dict(os.environ)
    import glob
    auths = sorted(glob.glob("/run/user/%d/.mutter-Xwaylandauth.*" % os.getuid()),
                   key=os.path.getmtime, reverse=True)
    if auths:
        env["XAUTHORITY"] = auths[0]
    subprocess.Popen(["gtk-launch", "antigravity"], env=env, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_save(label):
    raw = read_keyring()
    email = email_of(raw)
    if not email:
        sys.exit("Не удалось определить email текущего аккаунта")
    name = slug(label)
    path = os.path.join(VAULT, name + ".json")
    with open(path, "w", encoding="utf-8") as f:
        f.write(raw.strip() + "\n")
    os.chmod(path, 0o600)
    idx = load_index()
    idx[name] = {"label": label, "email": email, "file": os.path.basename(path)}
    save_index(idx)
    open(CURRENT, "w").write(name)
    print(f"Сохранено: {label} ({email})")


def cmd_list(json_out=False):
    idx = load_index()
    cur = current_label()
    if json_out:
        print(json.dumps([{"key": k, **v, "active": k == cur} for k, v in idx.items()],
                         ensure_ascii=False))
        return
    if not idx:
        print("Нет сохранённых аккаунтов. Сначала: ag-accounts save <имя>")
        return
    for name, info in idx.items():
        mark = "*" if name == cur else " "
        print(f"{mark} {info['label']:<20} {info['email']:<40} [{name}]")


def cmd_use(query):
    idx = load_index()
    key = query if query in idx else slug(query)
    if key not in idx:
        sys.exit(f"Аккаунт не найден: {query}. Сначала ag-accounts list")
    path = os.path.join(VAULT, idx[key]["file"])
    with open(path, encoding="utf-8") as f:
        raw = f.read()
    write_keyring(raw)
    email = idx[key]["email"]
    if email_of(read_keyring()) != email:
        sys.exit("Не удалось записать аккаунт — переключение отменено")
    try:
        storage = json.load(open(STORAGE, encoding="utf-8"))
        storage["agy.onboarding.lastLoginUsername"] = email
        json.dump(storage, open(STORAGE, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    except Exception:
        pass
    open(CURRENT, "w").write(key)
    print(f"Активен: {idx[key]['label']} ({email}). Перезапуск Antigravity…")
    restart_app()


def cmd_current(json_out=False):
    try:
        email = email_of(read_keyring())
    except Exception:
        email = ""
    cur = current_label()
    label = load_index().get(cur, {}).get("label", cur) if cur else ""
    if json_out:
        print(json.dumps({"email": email, "label": label, "key": cur}, ensure_ascii=False))
        return
    print(f"Текущий Google-аккаунт: {email or '(не авторизован)'}")
    if cur:
        print(f"Профиль: {label or cur}")


def cmd_add(label):
    if not load_index():
        cmd_save("Основной")
    else:
        cmd_save("Перед добавлением")
    clear_keyring()
    open(os.path.join(VAULT, "pending_add"), "w", encoding="utf-8").write(label)
    print("Вход сброшен. Войди в Antigravity другим Google-аккаунтом — он сохранится автоматически.")
    restart_app()


def cmd_next():
    idx = load_index()
    keys = list(idx.keys())
    if not keys:
        sys.exit("Нет сохранённых аккаунтов")
    cur = current_label()
    i = keys.index(cur) if cur in keys else -1
    nxt = keys[(i + 1) % len(keys)]
    print(f"Следующий: {idx[nxt]['label']} ({idx[nxt]['email']})")
    cmd_use(idx[nxt]["label"])


def cmd_remove(query):
    idx = load_index()
    key = query if query in idx else slug(query)
    if key not in idx:
        sys.exit("Не найден")
    path = os.path.join(VAULT, idx[key]["file"])
    if os.path.isfile(path):
        os.remove(path)
    del idx[key]
    save_index(idx)
    if current_label() == key and os.path.isfile(CURRENT):
        os.remove(CURRENT)
    print("Удалено")


def main():
    os.makedirs(VAULT, mode=0o700, exist_ok=True)
    if len(sys.argv) < 2:
        sys.exit("Использование: ag-accounts <save|list|use|current|add|remove> [имя]")
    cmd, args = sys.argv[1], sys.argv[2:]
    json_out = "--json" in args
    args = [a for a in args if a != "--json"]
    {"save": lambda: cmd_save(" ".join(args) or "Без имени"),
     "list": lambda: cmd_list(json_out),
     "use": lambda: cmd_use(" ".join(args)),
     "add": lambda: cmd_add(" ".join(args) or "Новый аккаунт"),
     "current": lambda: cmd_current(json_out),
     "next": cmd_next,
     "remove": lambda: cmd_remove(" ".join(args))}[cmd]()


if __name__ == "__main__":
    main()
